# Secrets — never commit real credentials.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Python virtual environments.
.venv/
backend/.venv/
venv/
env/

# Python caches / build artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Runtime call data and recordings (may contain caller PII).
# Two layouts: DATA_DIR/<org_id>/calls is where traces are written now, and
# DATA_DIR/calls is where every call before organisations existed was written.
backend/data/calls/*
!backend/data/calls/.gitkeep
backend/data/*/calls/*
!backend/data/*/calls/.gitkeep
backend/data/reflow/*
!backend/data/reflow/.gitkeep

# The platform database: organisations, users, memberships, sessions. It holds
# password hashes and encrypted clinic credentials and lives on the Fly volume
# next to the traces. It is created and migrated at boot; it is never source.
backend/data/platform.db
backend/data/platform.db-wal
backend/data/platform.db-shm
*.raw
*.wav
*.mp3
*.ulaw

# OS / editor noise.
.DS_Store
.idea/
.vscode/
