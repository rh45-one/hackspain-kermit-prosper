anyOf': [{'type': 'string'}, {'type': 'null'}], 'description': "Site requested, if any ('Centro', 'Norte', 'Sur')."}, 'part_of_day': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'description': "'morning' or 'afternoon', if the caller said one."}, 'language': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'description': 'Language the caller needs the doctor to speak, if said.'}, 'insurer': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'description': 'An insurance plan the caller names that is NOT the one on their record. Leave it out and the search prices against the plan on file; a second plan exists nowhere in the data and only the caller can reveal it, so pass it here the moment they mention one.'}}, 'required': ['when_phrase']}, 'behavior': 'BLOCKING'}, {'name': 'book_appointment', 'description': 'Queue a booking of a confirmed slot for the confirmed patient.', 'parameters': {'type': 'object', 'properties': {'slot_token': {'type': 'string', 'description': 'A token returned by find_availability in this call.'}, 'policy_id': {'anyOf': [{'type': 'string'}, {'type': 'null'}], 'description': "The insurance plan to bill, if the caller named one; otherwise the patient's plan on file."}}, 'required': ['slot_token']}, 'behavior': 'BLOCKING'}, {'name': 'cancel_appointment', 'description': "Cancel one of the confirmed patient's upcoming appointments.", 'parameters': {'type': 'object', 'properties': {'appointment_id': {'type': 'string', 'description': 'An appointment_id from list_my_appointments.'}}, 'required': ['appointment_id']}, 'behavior': 'BLOCKING'}, {'name': 'reschedule_appointment', 'description': "Move one of the confirmed patient's upcoming appointments to a new confirmed slot.", 'parameters': {'type': 'object', 'properties': {'appointment_id': {'type': 'string', 'description': 'An appointment_id from list_my_appointments.'}, 'slot_token': {'type': 'string', 'description': 'A token returned by find_availability for the new slot.'}, 'policy_id': {'anyOf