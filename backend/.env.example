# Prosper agent configuration. Copy to .env and fill in. NEVER commit .env.

# --- Prosper platform (desk gives these) ---
PROSPER_API_BASE_URL=https://hackspain.getprosperapp.com
PROSPER_API_KEY=pk-REPLACE_ME

# --- Agent brain: Helmcode (OpenAI-compatible) ---
HELMCODE_API_KEY=sk-hke_REPLACE_ME
HELMCODE_BASE_URL=https://api.helmcode.com/v1
AGENT_MODEL=glm5.3
AGENT_MODEL_FALLBACK=deepseek-v4-flash

# --- Voice ---
DEEPGRAM_API_KEY=REPLACE_ME
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_VOICE_ID=REPLACE_ME
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
CARTESIA_API_KEY=            # optional fallback

# --- Voice engine: cascade (default, always the rollback) or gemini_live ---
# gemini_live becomes the default only after the offline acceptance gate and a
# scored live Run All; switching engines is a configuration decision made
# before the call, never mid-call.
VOICE_ENGINE=cascade

# --- Gemini Live audio host (VOICE_ENGINE=gemini_live) ---
GEMINI_API_KEY=REPLACE_ME
GEMINI_LIVE_MODEL=gemini-3.8-live
# server streams continuous audio to Gemini; local uses Silero activity windows.
GEMINI_VAD_MODE=server
GEMINI_VOICE_ID=Charon

# --- TypeSafe Jev structured-decision sidecar (advisory only) ---
TYPESAFE_API_KEY=REPLACE_ME
TYPESAFE_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=0.3
JEV_MIN_CONFIDENCE=0.5

# --- Server ---
VOICE_WS_HOST=0.0.0.0
VOICE_WS_PORT=7860
OPS_HTTP_PORT=7861
# Tunneled endpoint announced to the harness (used by `make check-ws`).
PUBLIC_WS_URL=wss://your-name.ngrok-free.app/ws

# --- Behaviour ---
CALLER_TZ=Europe/Madrid
MAX_CALL_MINUTES=3
SUBMIT_WINDOW_SECONDS=30
# Relative paths resolve against the backend/ root, not the cwd.
DATA_DIR=./data
LOG_LEVEL=INFO
