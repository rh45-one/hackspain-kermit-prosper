# Prosper agent configuration. Copy to .env and fill in. NEVER commit .env.

# --- Prosper platform (desk gives these) ---
PROSPER_API_BASE_URL=https://hackspain.getprosperapp.com
PROSPER_API_KEY=pk-REPLACE_ME

# --- Agent brain: Helmcode (OpenAI-compatible) ---
HELMCODE_API_KEY=sk-hke_REPLACE_ME
HELMCODE_BASE_URL=https://api.helmcode.com/v1
AGENT_MODEL=glm5.3
AGENT_MODEL_FALLBACK=deepseek-v4-flash

# --- Voice ---
DEEPGRAM_API_KEY=REPLACE_ME
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=multi
ELEVENLABS_API_KEY=REPLACE_ME
ELEVENLABS_VOICE_ID=REPLACE_ME
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
CARTESIA_API_KEY=            # optional fallback

# --- Server ---
VOICE_WS_HOST=0.0.0.0
VOICE_WS_PORT=7860
OPS_HTTP_PORT=7861
# Tunneled endpoint announced to the harness (used by `make check-ws`).
PUBLIC_WS_URL=wss://your-name.ngrok-free.app/ws

# --- Behaviour ---
CALLER_TZ=Europe/Madrid
MAX_CALL_MINUTES=3
SUBMIT_WINDOW_SECONDS=30
# Relative paths resolve against the backend/ root, not the cwd.
DATA_DIR=./data
LOG_LEVEL=INFO
