# Backend that serves the live view. Point this at the ops process, NOT at the
# voice server: port 7860 is the one carrying scored calls behind the tunnel.
AGENT_HTTP_BASE_URL=http://127.0.0.1:7861

# Shared secret for /ops. Server-side only — never rename it to NEXT_PUBLIC_*,
# which would inline it into the browser bundle. Leave it empty when the ops
# process is on this same machine: it serves loopback without a token.
OPS_TOKEN=

# Opt into the original simulated FrontDesk data and local settings.
FRONTDESK_DEMO=false
