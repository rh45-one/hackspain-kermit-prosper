# Backend that serves the live view. Point this at the ops process, NOT at the
# voice server: port 7860 is the one carrying scored calls behind the tunnel.
AGENT_HTTP_BASE_URL=http://127.0.0.1:7861

# Shared secret for /ops. Server-side only — never rename it to NEXT_PUBLIC_*,
# which would inline it into the browser bundle. Leave it empty when the ops
# process is on this same machine: it serves loopback without a token.
OPS_TOKEN=

# Opt into the original simulated FrontDesk data and local settings.
FRONTDESK_DEMO=false

# Voice process that serves /healthz and /ws/demo. Defaults to AGENT_HTTP_BASE_URL
# if unset. Point this at the voice server (7860), not the ops reader (7861).
VOICE_HTTP_BASE_URL=http://127.0.0.1:7860

# Set true when Next and the voice server share a public host (reverse proxy).
VOICE_SAME_ORIGIN=false

# Public address of the agent's browser call page (`/call`), which is what the
# "Llamar" QR in the routing map points at. Only needed when the panel reaches
# the agent over an address a phone cannot: on Vercel, AGENT_HTTP_BASE_URL is
# already the public host and this can stay empty.
VOICE_PUBLIC_BASE_URL=
